{
  "name": "tars",
  "version": "1.0.0",
  "description": "Terminal AI coding agent — no setup, just tars",
  "main": "./dist/tui/tui.js",
  "bin": {
    "tars": "./dist/tui/tui.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun src/tui/tui.tsx",
    "build": "tsc",
    "build:binary": "bun build ./src/tui/tui.tsx --compile --outfile tars",
    "build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:windows-x64",
    "build:darwin-arm64": "bun build ./src/tui/tui.tsx --compile --target=bun-darwin-arm64 --outfile tars-darwin-arm64",
    "build:darwin-x64": "bun build ./src/tui/tui.tsx --compile --target=bun-darwin-x64 --outfile tars-darwin-x64",
    "build:linux-x64": "bun build ./src/tui/tui.tsx --compile --target=bun-linux-x64 --outfile tars-linux-x64",
    "build:linux-arm64": "bun build ./src/tui/tui.tsx --compile --target=bun-linux-arm64 --outfile tars-linux-arm64",
    "build:windows-x64": "bun build ./src/tui/tui.tsx --compile --target=bun-windows-x64 --outfile tars-windows-x64.exe",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vansh-vm04/tars.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/vansh-vm04/tars/issues"
  },
  "homepage": "https://github.com/vansh-vm04/tars#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "chalk": "^6.0.0",
    "react": "^19.2.8"
  },
  "trustedDependencies": [
    "@google/genai",
    "protobufjs"
  ]
}
